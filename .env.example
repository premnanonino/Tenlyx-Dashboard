# --- Login (required) -------------------------------------------------------
# Anyone with an @LOGIN_EMAIL_DOMAIN address signs in with one shared password.
# Don't edit the hash by hand. Generate it with:
#   npm --prefix server run set-password            # prints a generated password
#   npm --prefix server run set-password -- --prompt  # type your own
LOGIN_EMAIL_DOMAIN=courserev.ai
SHARED_PASSWORD_HASH=
# SESSION_TTL_HOURS=12
# COOKIE_SECURE=1        # set when serving over HTTPS
# ALLOWED_ORIGINS=https://billing.example.com   # extra origins allowed to POST (reverse proxy)

# Telnyx API v2 key (Mission Control → Auth → API Keys).
# Required: the server refuses to start without it.
TELNYX_API_KEY=

# Detail record types to pull (comma separated): messaging, call-control, sip-trunking, verify …
# call-control and sip-trunking are separate charges on the same call leg; keep both for true voice spend.
TELNYX_RECORD_TYPES=messaging,call-control,sip-trunking
# Detail record types holding Conversational AI usage (skipped automatically if unsupported)
TELNYX_AI_RECORD_TYPES=ai-voice-assistant
TELNYX_BACKFILL_DAYS=7
TELNYX_MAX_PAGES=200
# Ceiling for adaptive pacing (it starts at 1 req/s and halves on every 429)
TELNYX_RPS=2

PORT=8787

# --- Database (optional) ------------------------------------------------------
# No database configured = local development, data in memory.
# DATABASE_BACKEND=postgres          # default: DATABASE_URL or PGHOST/PGUSER/PGDATABASE/PGPASSWORD(_FILE)
# DATABASE_URL=postgres://user:pass@host:5432/tlxmon
#
# DATABASE_BACKEND=libsql            # libSQL / SQLite ("turso" is an alias)
# LIBSQL_URL=file:./data/tlxmon.db   # local SQLite file, or for Turso:
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=                  # TURSO_AUTH_TOKEN_FILE also supported
POLL_BALANCE_MS=30000
POLL_RECORDS_MS=60000

# Monthly reports: how many past months to backfill into rollups
REPORT_HISTORY_MONTHS=3

# Alert thresholds (editable at runtime from the dashboard)
ALERT_LOW_BALANCE=250
ALERT_RUNWAY_DAYS=7
ALERT_SPIKE_Z=3

# LOG_LEVEL=info

# --- Call History (optional) --------------------------------------------------
# Read-only copy of CourseRev's call history (public.conversations). Use a READ-ONLY
# database user; the app also forces read-only sessions. Unset = page shows "not configured".
# CR_DATABASE_URL=postgresql://<readonly-user>:<password>@<host>:5432/courserev_prod?sslmode=require
# CALLS_HISTORY_DAYS=90
